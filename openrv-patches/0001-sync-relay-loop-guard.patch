+    //
+    //  Loop guard for relayed graph-state events (annotations etc).
+    //  syncState re-sends every received graph event to the other
+    //  contacts. That is correct in a star (one host relaying for
+    //  everyone) but if the contact graph has a cycle -- e.g. two
+    //  participants in a room also connect to each other directly --
+    //  the same payload comes back around through a different neighbor
+    //  and insert*Property calls would duplicate strokes forever.
+    //  A loop copy always arrives via a DIFFERENT sender within
+    //  milliseconds, while a legitimate repeat comes from the same
+    //  sender, so drop identical payloads seen from another sender in
+    //  the last 2 seconds.
+    //
+    method: graphLoopDuplicate (bool; string payload, string sender)
+    {
+        let now = theTime();
+        bool dup = false;
+
+        for_index (i; _recentGraphPayloads)
+        {
+            if (!dup &&
+                now - _recentGraphTimes[i] < 2.0 &&
+                _recentGraphSenders[i] != sender &&
+                _recentGraphPayloads[i] == payload)
+            {
+                dup = true;
+            }
+        }
+
+        if (_recentGraphPayloads.size() >= 64)
+        {
+            _recentGraphPayloads.erase(0, 1);
+            _recentGraphSenders.erase(0, 1);
+            _recentGraphTimes.erase(0, 1);
+        }
+
+        _recentGraphPayloads.push_back(payload);
+        _recentGraphSenders.push_back(sender);
+        _recentGraphTimes.push_back(now);
+
+        return dup;
+    }
 
