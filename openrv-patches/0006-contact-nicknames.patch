+    void RvNetworkDialog::popupRename(bool)
+    {
+        //
+        //  Let the user set a custom display name ("nickname") for the
+        //  selected contact, purely cosmetic -- see m_contactAliases.
+        //  Connection/permission matching is untouched; it still keys
+        //  off the real Name/Machine columns exactly as before.
+        //
+
+        set<int> rows = selectedContacts();
+
+        if (rows.empty())
+            return;
+
+        int row = *rows.begin();
+
+        QStandardItem* name = m_contactsModel->item(row, 1);
+        QStandardItem* host = m_contactsModel->item(row, 2);
+        QStandardItem* nick = m_contactsModel->item(row, 6);
+
+        QString aliasKey = name->text() + "@" + host->text();
+        QString current = nick->text();
+
+        bool ok = false;
+        QString newNick = QInputDialog::getText(
+            this, "Rename Contact",
+            QString("Display name for %1:\n(leave blank to show the system name again)").arg(aliasKey), QLineEdit::Normal, current, &ok);
+
+        if (!ok)
+            return;
+
+        newNick = newNick.trimmed();
+        nick->setText(newNick);
+
+        if (newNick.isEmpty())
+            m_contactAliases.remove(aliasKey);
+        else
+            m_contactAliases[aliasKey] = newNick;
+
+        saveSettings();
+    }
