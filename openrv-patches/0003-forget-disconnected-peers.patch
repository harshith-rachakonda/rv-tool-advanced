+    //
+    //  Remove a connection by value. Never key this on peerAddress(): Qt
+    //  returns a Null address once the socket is no longer connected, so
+    //  remove(peerAddress(), c) silently missed for every dropped peer,
+    //  leaving a pointer to an already-deleted Connection in the map.
+    //  connectionByName() dereferences every entry (use-after-free), and the
+    //  stale name made a dropped peer look "already connected" forever, so
+    //  it could never rejoin until RV's networking was restarted.
+    //
+    bool Client::forgetConnection(Connection* c)
+    {
+        bool removed = false;
+        for (ConnectionMap::iterator i = m_connectionMap.begin(); i != m_connectionMap.end();)
+        {
+            if (i.value() == c)
+            {
+                i = m_connectionMap.erase(i);
+                removed = true;
+            }
+            else
+            {
+                ++i;
+            }
+        }
+        return removed;
+    }
+
     void Client::rejectConnection(Connection* c)
     {
+        forgetConnection(c);
         c->abort();
-        m_connectionMap.remove(c->peerAddress(), c);
